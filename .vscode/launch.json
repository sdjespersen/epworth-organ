    "version": "0.2.0",
    "configurations": [
        {
            "type": "probe-rs-debug",
            "request": "attach",
            "name": "probe-rs debug epworth-organ",
            "cwd": "${workspaceFolder}",
            "connectUnderReset": false,
            "chip": "RP235x",
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "${workspaceFolder}/target/thumbv8m.main-none-eabihf/debug/epworth-organ"
                }
            ],
            "consoleLogLevel": "Console"
        },
        {
            "type": "probe-rs-debug",
            "request": "attach",
            "name": "probe-rs debug primary-decoder",
            "cwd": "${workspaceFolder}",
            "connectUnderReset": false,
            "chip": "RP235x",
            "coreConfigs": [
                {
                    "coreIndex": 0,
                    "programBinary": "${workspaceFolder}/target/thumbv8m.main-none-eabihf/debug/primary-decoder"
                }
            ],
            "consoleLogLevel": "Console"
        }
    ]
}
